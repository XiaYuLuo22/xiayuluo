# Copy this file to .env. Never commit your actual API key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Project Codex is allowed to work on; must be an existing local directory.
# Windows example: C:/Users/you/projects/my-project
CODEX_WORKSPACE=
CODEX_EXECUTABLE=codex
# read-only by default. Set workspace-write to allow edits in that project.
CODEX_SANDBOX=read-only

# Optional paired phone gateway. Requires an HTTPS reverse proxy; never expose /api.
# Uses ASSISTANT_PORT for a stable loopback port when enabled.
MOBILE_ENABLED=false

# Enable only on your local desktop. Windows may need screen capture permission.
DESKTOP_ENABLED=false
ASSISTANT_PORT=8765
# Local memory database. Back up this directory if you want to retain memories.
ASSISTANT_DATA_DIR=.assistant
