# Copy this file to .env. Never commit your actual API key.
# auto: configured API first, otherwise Codex ChatGPT-login Q&A.
# codex: always use Codex Q&A; api: always use the configured model API.
CHAT_PROVIDER=auto
# Application approval default. The saved desktop settings override this default.
# auto: immediately execute configured tools; manual: confirm each tool on desktop.
# Does not grant OS/CLI privileges or disable the configured sandbox.
APPROVAL_MODE=auto
# Native Windows window opens -> one automatic local voice attempt. Never headless.
# Requires voice dependencies, the offline model, Chinese system TTS, mic and CLI login.
# false disables automatic start; manual start/stop remains available.
VOICE_AUTOSTART=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Project Codex is allowed to work on; must be an existing local directory.
# Windows example: C:/Users/you/projects/my-project
CODEX_WORKSPACE=
CODEX_EXECUTABLE=codex
# read-only by default. Set workspace-write to allow edits in that project.
CODEX_SANDBOX=read-only

# Optional paired phone gateway. Requires an HTTPS reverse proxy; never expose /api.
# Uses ASSISTANT_PORT for a stable loopback port when enabled.
MOBILE_ENABLED=false

# Enable only on your local desktop. Windows may need screen capture permission.
DESKTOP_ENABLED=false
ASSISTANT_PORT=8765
# Local memory database. Back up this directory if you want to retain memories.
ASSISTANT_DATA_DIR=.assistant
# Training datasets/models/checkpoints/backups: separate from App install and memory.
# Empty: use registered location, otherwise %LOCALAPPDATA%/Xiayuluo/training on Windows.
# Optional absolute path, e.g. E:/XiayuluoData/training. Never put it in E:/Xiayuluo.
# Once registered, changing this value does NOT move or replace existing data.
ASSISTANT_TRAINING_DIR=
