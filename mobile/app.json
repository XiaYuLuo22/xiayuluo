{
  "expo": {
    "name": "夏鱼洛",
    "slug": "xiayuluo",
    "version": "0.1.12",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "xiayuluo",
    "ios": { "bundleIdentifier": "com.xiayuluo.assistant", "supportsTablet": true },
    "android": {
      "package": "com.xiayuluo.assistant",
      "versionCode": 13,
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": ["expo-secure-store", "./plugins/withVoice.cjs"]
  }
}
