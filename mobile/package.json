{
  "name": "xiayuluo-mobile",
  "version": "0.1.18",
  "private": true,
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo start --localhost --android",
    "ios": "expo start --localhost --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "export:android": "expo export --platform android --output-dir build-preview",
    "preview:web": "expo export --platform web --output-dir build-web-preview"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "expo": "58.0.14",
    "expo-application": "58.1.2",
    "expo-file-system": "58.0.9",
    "expo-intent-launcher": "58.0.3",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
