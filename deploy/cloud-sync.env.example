# Keep the real environment file outside the public source checkout.
# Generate a private random token yourself (>=32 ASCII chars). No built-in token.
XIAYULUO_CLOUD_ADMIN_TOKEN=
# Use an existing private data volume, not an application installation folder.
XIAYULUO_CLOUD_DATABASE=/var/lib/xiayuluo-cloud/private.sqlite3
# Must match your own TLS hostname. No wildcard hosts.
XIAYULUO_CLOUD_HOSTS=sync.example.invalid
